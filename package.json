{
  "name": "ttip",
  "version": "1.0.0",
  "private": true,
  "description": "Ttip — crypto in, cash out, tip anyone. Swap BTC/ETH/USDT to African fiat and tip friends instantly.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/setup-db.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts --force",
    "audit:funding": "tsx scripts/audit-funding.ts",
    "clawback": "tsx scripts/clawback-simulated.ts",
    "backfill:kyc-tiers": "tsx scripts/backfill-kyc-tiers.ts",
    "cap:sync": "cap sync",
    "cap:android": "cap sync android && cap open android",
    "cap:ios": "cap sync ios && cap open ios",
    "cap:assets": "capacitor-assets generate --iconBackgroundColor '#07080D' --iconBackgroundColorDark '#07080D' --splashBackgroundColor '#07080D' --splashBackgroundColorDark '#07080D'",
    "telegram:setup": "node scripts/telegram-setup.mjs",
    "telegram:status": "node scripts/telegram-setup.mjs --status"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.2.1",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@prisma/client": "^5.22.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "bcryptjs": "^2.4.3",
    "bs58": "^6.0.0",
    "jose": "^5.9.6",
    "next": "^14.2.35",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.32.6",
    "undici": "^6.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.25",
    "prisma": "^5.22.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
