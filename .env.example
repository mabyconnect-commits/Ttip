# ---- Database ----
# Any PostgreSQL connection string. On Vercel use Vercel Postgres or a free Neon DB.
# Local dev example:
DATABASE_URL="postgresql://ttip:ttip@127.0.0.1:5432/ttip?schema=public"

# ---- Auth ----
# Long random string used to sign session JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---- App ----
# Public base URL of the deployment (used for tip links / QR codes). No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Prices (optional) ----
# CoinGecko works without a key on the free demo endpoint. If you have a Demo/Pro key, set it here.
COINGECKO_API_KEY=""

# ---- Settlement (crypto-in / fiat-out) ----
# "sandbox" (default): no external money moves — deposits are credited by the
# in-app simulator or a signed webhook, payouts settle instantly without a bank.
# "live": real crypto deposits (provider webhook) + real Flutterwave payouts.
SETTLEMENT_MODE="sandbox"

# Shared secret for the inbound crypto-deposit webhook (/api/webhooks/deposit).
# The provider signs the raw body with HMAC-SHA256 and sends the hex digest in
# the `x-ttip-signature` header. Generate with: openssl rand -hex 32
DEPOSIT_WEBHOOK_SECRET=""

# Which provider sends naira payouts in live mode: "paystack" or "flutterwave".
# If unset, whichever has keys is used (Paystack preferred). Payout fees on both
# are a small flat/capped amount per transfer — not a percentage.
PAYOUT_PROVIDER=""

# Flutterwave payouts (naira & other African currencies). Use a TEST secret key
# (FLWSECK_TEST-…) to exercise the flow, a live key to move real money.
FLUTTERWAVE_SECRET_KEY=""
# Value of the "Secret hash" you set in the Flutterwave dashboard webhook config;
# it arrives back in the `verif-hash` header on /api/webhooks/payout.
FLUTTERWAVE_WEBHOOK_HASH=""
# Optional override; defaults to https://api.flutterwave.com/v3
FLUTTERWAVE_BASE_URL=""

# Paystack payouts (alternative to Flutterwave). Use a TEST secret key
# (sk_test_…) to exercise the flow, a live key to move real money. The same key
# verifies the payout webhook (HMAC-SHA512, `x-paystack-signature` header).
PAYSTACK_SECRET_KEY=""
# Optional override; defaults to https://api.paystack.co
PAYSTACK_BASE_URL=""

# Monnify payouts (cheapest published transfer tiers: ₦10/₦20/₦40).
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""
MONNIFY_SOURCE_ACCOUNT="" # your Monnify wallet account funds are disbursed from
MONNIFY_BASE_URL="" # defaults to https://api.monnify.com (sandbox: https://sandbox.monnify.com)

# CoralPay payouts. Confirm exact endpoint/fields against your CoralPay pack.
CORALPAY_MERCHANT_ID=""
CORALPAY_SECRET_KEY=""
CORALPAY_BASE_URL=""

# ---- Crypto deposits (Dextopus) ----
# Dextopus: cross-chain deposits across 70+ networks, non-custodial, ~0.25%/tx.
# Leave blank to use the in-app sandbox simulator instead.
DEPOSIT_PROVIDER="" # "dextopus" | "sandbox" (auto: dextopus if key set)
DEXTOPUS_API_KEY="" # x-api-key from the Dextopus dashboard (pk_...)
DEXTOPUS_WEBHOOK_SECRET="" # verifies deposit webhooks (X-Signature-SHA256, timestamp.body HMAC)
DEXTOPUS_BASE_URL="" # defaults to https://swap-api.dextopus.com
# Cross-chain settlement target — where deposits land (your treasury wallet):
DEXTOPUS_SETTLEMENT_CHAIN_ID="" # e.g. Tron / Base chain id
DEXTOPUS_SETTLEMENT_ASSET="" # e.g. USDT
DEXTOPUS_SETTLEMENT_ADDRESS="" # your treasury address on that chain
DEXTOPUS_REFUND_TO="" # optional; else set a per-VM default in the dashboard

# ---- Pricing ----
# Spread kept on crypto↔fiat. User is quoted market rate minus this margin;
# the difference is platform revenue. Keep tight to stay competitive. Default 1.5%.
PLATFORM_MARGIN_PCT="0.015"

# P2P premium over official FX, to track the parallel/Bybit-P2P rate. Global with
# P2P_PREMIUM_PCT, or per-currency with P2P_PREMIUM_<CODE> (e.g. P2P_PREMIUM_NGN).
# Default 0 (use official rate). e.g. "0.03" = quote 3% above official.
P2P_PREMIUM_PCT=""

# Optional: override Dextopus network→chainId mapping as JSON, after checking
# GET /deposit/chains. e.g. {"trc20":728126428,"sol":1399811149}
DEXTOPUS_CHAIN_IDS=""

# ---- Email (password reset) ----
# Resend API key. Without it the "forgot password" flow returns a clear 503
# instead of silently dropping the email.
RESEND_API_KEY=""
MAIL_FROM="" # e.g. "Ttip <no-reply@ttip.site>"; defaults to no-reply@<domain>

# ---- Ada, the in-app assistant ----
# Anthropic API key. Without it the chat launcher simply doesn't render, so a
# deploy with no key shows no broken button.
ANTHROPIC_API_KEY=""

# ---- Fiat deposit fee ----
# The provider bills US to collect a bank transfer (Flutterwave ~1.5% on NGN,
# capped at ₦2,000). Without a deposit fee that cost came straight out of the
# float on every single deposit. Charged as: provider cost × (1 + markup).
# CONFIRM the rate and cap against your own Flutterwave contract.
DEPOSIT_FEE_MARKUP="0.2"          # 20% on top of the provider's cost
COLLECTION_FEE_CAP_NGN="2000"     # provider's cap, before markup. 0 = uncapped

# ---- Swaps ----
# Free swaps per user per day. DEFAULT 0 — a free swap earns nothing while still
# paying out 0.15% cashback, so each one was a straight loss. Set this only to
# run a deliberate, time-boxed promo.
FREE_SWAPS_PER_DAY="0"

# ---- Bills ----
# Service fee on airtime/data/electricity/TV/internet. Bills used to run at
# exactly zero margin while still costing us the provider and the float.
# NOTE: Nigerian VTU apps compete hard on airtime price and some give a small
# DISCOUNT instead of charging. Set BILL_FEE_PCT=0 to turn this off.
BILL_FEE_PCT="0.01"   # 1%
BILL_FEE_CAP="100"    # ₦100 max per bill. 0 = uncapped

# ---- Crypto deposits ----
# Default 0. The sweep provider charges ~0.25%/tx — confirm with them whether
# that is already deducted from the amount they report to us. If it IS, charging
# again double-bills the user. If it is NOT, we credit more than the treasury
# received and this should be ~0.003.
CRYPTO_DEPOSIT_FEE_PCT="0"

# ---- Telegram bot ----
# Token from @BotFather. SERVER-ONLY — never prefix it with NEXT_PUBLIC_, that
# would ship full control of the bot to every visitor's browser.
TELEGRAM_BOT_TOKEN=""
# Any long random string. Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header and the webhook rejects anything else —
# without it, the URL alone is enough for anyone to drive your bot.
TELEGRAM_WEBHOOK_SECRET=""
# Then point Telegram at the deployment:
#   APP_URL=https://www.ttip.site npm run telegram:setup
