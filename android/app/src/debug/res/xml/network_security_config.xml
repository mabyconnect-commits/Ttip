<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Overrides the release rules so the shell can be pointed at
  a laptop over plain http (CAP_SERVER_URL=http://192.168.x.x:3000) and so a
  proxy's certificate can be trusted while inspecting traffic. This file is
  never part of a release build, so neither relaxation reaches a user.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
