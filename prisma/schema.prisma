// Ttip — data model
// Money is stored as Decimal to avoid floating point drift.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String               @id @default(cuid())
  email            String               @unique
  username         String               @unique
  passwordHash     String
  name             String
  verified         Boolean              @default(false)
  avatarGradient   String               @default("135deg,#6D5BFF,#2AC8FF 60%,#3DF5B0")
  defaultFiat      String               @default("NGN")
  bankName         String?
  bankAccount      String? // masked, e.g. "GTBank ••7204"
  streakDays       Int                  @default(0)
  points           Int                  @default(0)
  freeSwapsLeft    Int                  @default(3)
  referralCode     String               @unique
  referredById     String?
  referralEarned   Decimal              @default(0) @db.Decimal(18, 2)
  cashback         Decimal              @default(0) @db.Decimal(18, 2) // earned cashback, claimable at the threshold
  pinHash          String?
  kycStatus        String               @default("unverified") // unverified | pending | verified
  // Tier 0 until an identity is actually verified. Tier is DERIVED from
  // kycIdTypes (see lib/constants KYC_TIERS), never granted on its own.
  kycTier          Int                  @default(0)
  // Which id types this user has verified, e.g. ["bvn","nin"]. BVN alone is
  // Tier 1; BVN + a government ID is Tier 2; + "address" is Tier 3.
  kycIdTypes       String[]             @default([])
  kycProvider      String? // which provider verified (dojah | sandbox | manual)
  kycRef           String? // provider reference / audit id for the identity check
  kycVerifiedAt    DateTime?
  resetTokens      PasswordResetToken[]
  bvnHash          String?              @unique // HMAC of the verified BVN — one BVN per account (anti-reuse) + trace
  bvnLast4         String? // last 4 digits of the BVN, for support/display
  nairaAccount     String? // dedicated virtual account number for naira funding
  nairaBank        String? // the bank that hosts the dedicated account
  lastDropAt       DateTime?
  freeSwapDay      String? // YYYY-MM-DD the free-swap allowance was last counted
  lastTipDay       String? // YYYY-MM-DD of the last tip sent (for streaks)
  // Telegram account link. Unique so one Telegram account can only ever be
  // bound to one Ttip account — otherwise a linked chat could be pointed at a
  // second account and read both.
  telegramChatId   String?              @unique
  telegramUsername String?
  telegramLinkedAt DateTime?
  telegramTokens   TelegramLinkToken[]
  passkeys         Passkey[]
  pushSubs         PushSubscription[]
  telegramDrafts   TelegramDraft[]
  giftCards        GiftCardOrder[]
  scheduledSends   ScheduledTransfer[]
  phoneLink        PhoneLink?
  createdAt        DateTime             @default(now())

  balances      Balance[]
  transactions  Transaction[]
  addresses     WalletAddress[]
  beneficiaries Beneficiary[]
  settlements   Settlement[]
  card          Card?
  feedItems     FeedItem[]      @relation("actor")
  referrals     Referral[]      @relation("referrer")
  campaigns     Campaign[]      @relation("campaignInfluencer")

  @@index([username])
}

model Balance {
  id     String  @id @default(cuid())
  userId String
  symbol String // BTC, ETH, USDT, USDC, SOL, NGN, GHS, KES, ZAR, USD
  kind   String // "crypto" | "fiat"
  amount Decimal @default(0) @db.Decimal(38, 18)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId])
}

model WalletAddress {
  id       String  @id @default(cuid())
  userId   String
  symbol   String // BTC, ETH, USDT, etc.
  network  String // Bitcoin, ERC-20, TRC-20, Solana, ...
  address  String
  provider String? // null = demo generator; "dextopus" = real provider-issued

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol, network])
  @@index([userId])
}

/// Single-use password-reset tokens. Only a HASH of the token is stored, so a
/// database leak can't be used to reset anyone's password; the raw token exists
/// only in the email we sent.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use, short-lived tokens that link a Telegram chat to a Ttip account.
///
/// The token is minted inside the signed-in app and travels to Telegram in a
/// t.me deep link, so possession of it proves the person holding that Telegram
/// account is the one who was signed in. Only a HASH is stored — the raw token
/// lives only in the link — and it dies on first use or after minutes, so a
/// leaked link is worthless almost immediately.
model TelegramLinkToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A transfer waiting for a PIN in a Telegram chat.
///
/// One live draft per chat, so a PIN typed into the chat can only ever apply to
/// the transfer the user was just shown — never to an older one still sitting
/// around. Short-lived and single-use for the same reason.
model TelegramDraft {
  id            String    @id @default(cuid())
  userId        String
  chatId        String    @unique
  /// Null while we still need to be told how much. A photo of an account gives
  /// us the recipient but rarely the amount, and the user supplies that in the
  /// next message — which they should not have to repeat the account for.
  /// "bank" | "crypto" — the two things a chat can send.
  kind          String    @default("bank")
  amount        Decimal?  @db.Decimal(18, 2)
  fiat          String
  /// Bank fields. Null on a crypto draft.
  accountNumber String?
  bankName      String?
  accountName   String?
  /// Crypto fields. Null on a bank draft.
  asset         String?
  network       String?
  address       String?
  /// Null when the bank could not confirm the name — the prompt says so.
  resolvedName  String?
  /// Set when the request named a time — "in 30 minutes", "tomorrow at 9".
  /// Confirming a draft that carries one SCHEDULES it instead of sending it.
  /// Without this the four words that changed WHEN were simply dropped, and
  /// the money went immediately.
  scheduleAt    DateTime?
  /// How the user put it, read back on the confirmation.
  scheduleSaid  String?
  /// Wrong-PIN attempts. The draft dies after a few, so a chat can't be used
  /// to grind PINs.
  attempts      Int       @default(0)
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// The recent back-and-forth in a Telegram chat.
///
/// The bot is a webhook: each message arrives as its own request with no memory
/// of the last, so the model was being handed ONE line and nothing else. It
/// answered every message as if the conversation had just begun — and when a
/// user asked "have you forgotten just now?", it said it had lost the thread,
/// because it genuinely had. This is that thread.
// A device that has agreed to receive push notifications.
//
// The endpoint is a URL at the browser vendor's push service — it identifies a
// device, not a person, and it is useless without the keys stored beside it.
// One user can have several (phone, laptop, an installed PWA), and any of them
// can go stale at any time, so a send that comes back 404/410 deletes the row
// rather than retrying for ever.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  @@index([userId])
}

// A passkey — Face ID, a fingerprint, or a security key.
//
// What is stored is a PUBLIC key. It verifies a signature and cannot produce
// one, so this table is useless to whoever steals it: the private half never
// leaves the phone's secure hardware, and the biometric itself is never sent
// anywhere. That is the whole point of offering this instead of a password —
// there is no shared secret left to phish, reuse or leak.
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Base64url credential id from the authenticator.
  credentialId String    @unique
  // Base64url COSE public key.
  publicKey    String
  // Replay guard: must never go backwards for a given credential.
  counter      BigInt    @default(0)
  // e.g. ["internal","hybrid"] — how the authenticator can be reached.
  transports   String[]  @default([])
  // What the user calls it: "iPhone", "Pixel".
  label        String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

model TelegramTurn {
  id        String   @id @default(cuid())
  chatId    String
  role      String /// "user" | "assistant"
  text      String   @db.VarChar(2000)
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  type         String // swap | ttip_out | ttip_in | deposit | withdraw_wallet | withdraw_bank | bill | card_fund | card_spend | referral_bonus | deposit_bonus | buy | cashback_earn
  status       String   @default("completed") // pending | completed | failed
  assetIn      String?
  amountIn     Decimal? @db.Decimal(38, 18)
  assetOut     String?
  amountOut    Decimal? @db.Decimal(38, 18)
  counterparty String? // @username, bank acct, wallet address, provider
  note         String?
  emoji        String?
  meta         Json?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Real-money movements handled by an external provider (crypto deposits swept
// into treasury, fiat payouts sent from the float). `externalId` is the
// provider's own id / on-chain tx hash and is unique, giving idempotency:
// a webhook that fires twice can never credit or pay out twice.
model Settlement {
  id         String   @id @default(cuid())
  userId     String? // null for system-level movements (e.g. treasury liquidation)
  kind       String // "deposit" | "payout" | "liquidation"
  provider   String // "sandbox" | "flutterwave" | "paystack" | "dextopus" | ...
  externalId String   @unique
  reference  String? // our own idempotency reference (payouts)
  status     String   @default("pending") // pending | completed | failed
  asset      String // USDT, USDC, NGN, ...
  amount     Decimal  @db.Decimal(38, 18)
  chain      String? // tron, bsc, ethereum, solana, ...
  address    String? // deposit address, or destination bank account
  raw        Json? // provider payload, kept for audit
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([reference])
}

// Platform-owned balances: the naira (and other fiat) float payouts draw from,
// and the crypto treasury swept from user deposits. The liquidity engine sells
// treasury crypto into the float to keep payouts instant even when the float
// alone can't cover a large withdrawal.
model TreasuryBalance {
  id        String   @id @default(cuid())
  symbol    String   @unique // USDT, NGN, GHS, ...
  kind      String // "crypto" | "fiat"
  amount    Decimal  @default(0) @db.Decimal(38, 18)
  updatedAt DateTime @updatedAt
}

model Beneficiary {
  id             String  @id @default(cuid())
  userId         String
  name           String
  handle         String? // @username or null
  type           String // ttip | bank | wallet
  detail         String // account / address / handle
  avatarGradient String  @default("135deg,#FF9A5B,#FF5B8F")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Card {
  id         String   @id @default(cuid())
  userId     String   @unique
  last4      String
  holder     String
  balanceUsd Decimal  @default(0) @db.Decimal(18, 2)
  frozen     Boolean  @default(false)
  expMonth   Int
  expYear    Int
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FeedItem {
  id         String   @id @default(cuid())
  actorId    String
  kind       String // tip | split | streak | swap
  actorName  String
  targetName String?
  amount     Decimal? @db.Decimal(18, 2)
  currency   String?
  note       String?
  emoji      String?
  reactions  Json     @default("{}")
  createdAt  DateTime @default(now())

  actor User @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  joinedName String
  bonus      Decimal  @default(2000) @db.Decimal(18, 2)
  createdAt  DateTime @default(now())

  referrer User @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

// An influencer deal. Someone with an audience is set a target — "get 100 people
// to sign up, deposit at least ₦1,000 of real money, trade, and still be holding
// it 72 hours later" — and paid a flat fee when they hit it.
//
// Admin-only: never listed publicly, and progress is counted from what actually
// happened rather than anything the influencer reports.
model Campaign {
  id           String  @id @default(cuid())
  name         String
  // The influencer. Their referral code is what attributes a signup.
  influencerId String
  note         String? // internal: agreed terms, contact, anything worth keeping

  // Qualification, all AND-ed together. A referral counts only if it meets all.
  minDepositNgn Decimal @default(1000) @db.Decimal(18, 2) // real money deposited
  requireTrade  Boolean @default(true) // must have swapped or bought
  holdHours     Int     @default(72) // …and held it this long
  minHoldNgn    Decimal @default(1000) @db.Decimal(18, 2) // …and still hold this much

  targetCount Int     @default(100) // how many qualified referrals to hit
  rewardNgn   Decimal @db.Decimal(18, 2) // paid on completion

  // Only signups after this count, so an old audience can't be re-billed.
  startsAt DateTime  @default(now())
  endsAt   DateTime?

  status String    @default("active") // active | paid | cancelled
  paidAt DateTime?

  createdAt DateTime @default(now())

  influencer User @relation("campaignInfluencer", fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([influencerId])
  @@index([status])
}

/// A transfer the user asked for later — "send this in 30 minutes", "pay her
/// tomorrow at 9".
///
/// The PIN is verified when the transfer is SCHEDULED, never stored: this is
/// the same bargain a standing order makes at a bank. Authorising it later
/// would need the user present, which is the one thing scheduling is for.
model ScheduledTransfer {
  id     String   @id @default(cuid())
  userId String
  /// "bank" today. Crypto sends wait until the treasury is reliable enough to
  /// promise a time.
  kind   String   @default("bank")
  /// scheduled → sending → sent | failed | cancelled
  status String   @default("scheduled")
  runAt  DateTime

  /// What to send. `symbol` is the wallet the user preferred; the payout is
  /// still funded from all of them, exactly as an immediate one is.
  fiat   String
  symbol String
  amount Decimal @db.Decimal(24, 8)

  bankName      String?
  accountNumber String?
  accountName   String?
  note          String?

  /// Where it was set up, so the result can be told to the same place.
  chatId String?
  /// What the user actually said, read back on confirmation: "in 30 minutes".
  said   String?

  attempts  Int       @default(0)
  error     String?
  reference String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([userId, status])
}

/// A payout that could not go out because the naira float was short.
///
/// The user's crypto is ALREADY debited and the payout row already exists — we
/// just haven't handed it to a provider that has no naira to send. It sits here
/// for a fixed window while the float is topped up (automatically, or by an
/// operator), and if nobody resolves it in time it fails and every funding leg
/// is refunded. A transfer that quietly hangs is the thing this prevents.
model PayoutHold {
  id            String  @id @default(cuid())
  userId        String
  /// The payout's reference — the same one on the Settlement and Transaction.
  reference     String  @unique
  fiat          String
  amountFiat    Decimal @db.Decimal(24, 8)
  /// How much of it the float couldn't cover, at the moment it was held.
  shortfallFiat Decimal @db.Decimal(24, 8)

  accountNumber String
  bankName      String?
  accountName   String?

  /// held → released | completed | failed
  status     String    @default("held")
  /// Fail-and-refund after this. Not a suggestion: a cron enforces it.
  deadline   DateTime
  resolvedBy String?
  resolvedAt DateTime?
  note       String?
  /// The top-up raised to cover it, if one was.
  jobId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, deadline])
  @@index([userId])
}

/// Turning treasury crypto into naira float, on an exchange.
///
/// One row per top-up attempt, so a half-finished one is visible rather than
/// lost between two systems: we know what was sent, when, on which chain, and
/// what came back. The on-chain leg is automatic; the P2P sell is where a
/// human still stands, and this row is what they're looking at.
model LiquidityJob {
  id       String @id @default(cuid())
  provider String
  /// created → funding → funded → completed | failed
  status   String @default("created")

  fiat        String
  /// Shortfall plus the buffer — what we're trying to raise.
  targetFiat  Decimal  @db.Decimal(24, 8)
  asset       String
  amountAsset Decimal  @db.Decimal(38, 18)
  /// What actually landed in the float, once someone confirms it.
  raisedFiat  Decimal? @db.Decimal(24, 8)

  /// Our on-chain transfer into the exchange.
  fundingTx      String?
  depositAddress String?
  /// The payout this was raised for, when it was raised for one.
  reference      String?
  error          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

/// A phone number proved to belong to an account.
///
/// SMS sender IDs are spoofable, so a message arriving "from" a number proves
/// nothing on its own. The number is bound here only after a code we sent to it
/// was typed back into the signed-in app — which proves control of the SIM AND
/// of the account, in that order.
model PhoneLink {
  id     String @id @default(cuid())
  userId String @unique
  /// E.164, e.g. +2348113866493. Unique so one SIM can only ever reach one
  /// account — otherwise a message would be ambiguous, and ambiguity about
  /// whose money is moving is not something to resolve by guessing.
  phone  String @unique

  /// In-flight verification. Only the HASH of the code is stored.
  codeHash   String?
  codeSentAt DateTime?
  attempts   Int       @default(0)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Single-use codes that authorise an SMS transfer, printed once.
///
/// The transaction PIN must NEVER travel by SMS: it is reusable, it sits in the
/// sent-items folder and on the carrier's SMSC, and the Telegram bot only gets
/// away with asking for it because it deletes the message — which SMS cannot
/// do. A code used once is worthless the moment it is read, which is the only
/// property that makes plaintext acceptable.
///
/// This is the old bank TAN sheet, and it is the one authorisation that works
/// with no data at all: the user gets the list while online and keeps it.
model SmsCode {
  id       String    @id @default(cuid())
  userId   String
  /// Which one it is — we ask for a specific number, so watching one message go
  /// by tells an eavesdropper nothing about the next.
  index    Int
  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, index])
  @@index([userId, usedAt])
}

/// Every inbound SMS, kept.
///
/// Two jobs. The provider's message id is unique here, so an aggregator that
/// retries a delivery cannot send the money twice. And when someone says "I
/// texted you and nothing happened", this is the only record that can answer
/// them.
model SmsCommand {
  id         String  @id @default(cuid())
  providerId String  @unique
  phone      String
  body       String
  userId     String?
  outcome    String
  reply      String?

  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

/// A gift card someone bought — and the code itself, encrypted.
///
/// The code IS the money. Anyone who reads it can spend it, it cannot be
/// cancelled, and there is nobody to call. So it is encrypted at rest with a
/// key derived from AUTH_SECRET, never logged, and only ever returned to the
/// account that bought it.
///
/// Same money shape as a bill: the user is debited and a pending row written in
/// one atomic step, the provider is asked, and a failure refunds every funding
/// leg. A card that never arrives must never leave someone out of pocket.
model GiftCardOrder {
  id     String @id @default(cuid())
  userId String

  /// Provider's product id, and what the user sees.
  productId    String
  brand        String
  country      String
  /// Face value and its currency, e.g. 25 USD.
  faceValue    Decimal @db.Decimal(18, 2)
  faceCurrency String

  /// What the user actually paid, in their own currency.
  costFiat Decimal @db.Decimal(24, 8)
  fiat     String

  /// pending → delivered | failed
  status      String  @default("pending")
  provider    String
  reference   String  @unique
  /// Provider's own order id, for status re-queries.
  providerRef String?
  error       String?

  /// AES-256-GCM. Null until the provider hands the card over.
  codeCipher String?
  /// Shown in the list without decrypting anything.
  codeHint   String?
  /// Some brands need a PIN alongside the code.
  pinCipher  String?
  /// Set the first time the user reveals it — so "who has seen this" is answerable.
  revealedAt DateTime?

  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
